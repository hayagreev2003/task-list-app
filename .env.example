# Local Supabase values. After `npm run db:start`, run `npx supabase status -o env`
# and copy API_URL, PUBLISHABLE_KEY and SECRET_KEY here.
# Copy this file to .env.local (gitignored) and fill it in.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Used ONLY by the integration-test helper to create test users. Never read by app code.
SUPABASE_SECRET_KEY=
